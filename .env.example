# ANA特典航空券 空席サーチ 環境設定ファイル
# このファイルをコピーして「ana-award-search.env」という名前で config フォルダ等に保存してください。

# ANAマイレージクラブ情報（ANA自動ログイン・検索画面自動入力用）
ANA_MEMBER_ID=your_ana_member_id_here
ANA_PASSWORD=your_ana_password_here

# ユナイテッド航空（MileagePlus）情報（スターアライアンス空席データ取得用）
UA_USERNAME=your_ua_username_here
UA_PASSWORD=your_ua_password_here

# システム動作設定
# SCRAPER_PROVIDER: "mock" (テスト用ダミーデータ) または "ua" (ユナイテッド実検索)
SCRAPER_PROVIDER=ua
MIN_DELAY_SEC=2.0
MAX_DELAY_SEC=4.0
LONG_BREAK_EVERY=10
LONG_BREAK_SEC=20.0
MAX_RETRIES=3
MAX_QUERIES_PER_JOB=200
