# -*- coding: utf-8 -*-
# ANA特典航空券 空席サーチ 環境設定ファイル（サンプル）
# このファイルをコピーして「ana-award-search.env」という名前で config フォルダ等に保存してください。

# ANAマイレージクラブ情報（ANA自動ログイン・検索画面自動入力用）
ANA_MEMBER_ID=your_ana_member_id_here
ANA_PASSWORD=your_ana_password_here

# ユナイテッド航空（MileagePlus）情報（スターアライアンス空席データ取得用）
UA_USERNAME=your_ua_username_or_email_here
UA_PASSWORD=your_ua_password_here

# ホストAPI認証用共有シークレットトークン（指示13: ランダムな値を生成して設定すること。未設定時は安全のためアクセスが拒否されます）
HOST_API_TOKEN=

# システム動作設定
# SCRAPER_PROVIDER: "mock" (テスト用ダミーデータ) または "ua" (ユナイテッド実検索)
SCRAPER_PROVIDER=ua

# リクエスト間の安全待機秒数（BAN・アクセス制限回避のためのPolite delay設定）
# ※config.py のデフォルト値および実運用設定と統一
MIN_DELAY_SEC=4.0
MAX_DELAY_SEC=9.0
LONG_BREAK_EVERY=50
LONG_BREAK_SEC=90.0

# 再試行回数と1回の検索ジョブあたりの上限件数
MAX_RETRIES=3
MAX_QUERIES_PER_JOB=2000
